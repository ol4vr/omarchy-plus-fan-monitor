#!/usr/bin/env bash

set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
expected_id=io.github.ol4vr.fan-monitor
runtime_list="$repo/runtime-files.txt"
omarchy_path=${OMARCHY_PATH:-/home/ol4vr/.local/share/omarchy}

python3 - "$repo" "$expected_id" "$runtime_list" <<'PY'
from __future__ import annotations

import json
import sys
from pathlib import Path, PurePosixPath


root = Path(sys.argv[1]).resolve()
expected_id = sys.argv[2]
runtime_list = Path(sys.argv[3])

manifest_path = root / "manifest.json"
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))

required = ("schemaVersion", "id", "name", "version", "license", "kinds", "entryPoints")
missing = [key for key in required if key not in manifest]
if missing:
    raise RuntimeError(f"manifest keys missing: {', '.join(missing)}")
if manifest["schemaVersion"] != 1:
    raise RuntimeError("manifest schemaVersion must be 1")
if manifest["id"] != expected_id:
    raise RuntimeError(f"manifest ID must be {expected_id}")
if manifest["kinds"] != ["bar-widget"]:
    raise RuntimeError("Fan Monitor must declare only bar-widget")

entry = manifest["entryPoints"].get("barWidget")
if entry != "BarWidget.qml":
    raise RuntimeError("unexpected bar-widget entry point")

entry_path = PurePosixPath(entry)
if entry_path.is_absolute() or ".." in entry_path.parts:
    raise RuntimeError("unsafe manifest entry point")
if not (root / entry).is_file():
    raise RuntimeError("manifest entry point does not exist")

module_line = f'moduleName: "{expected_id}"'
for qml_name in ("BarWidget.qml", "Panel.qml"):
    qml_path = root / qml_name
    if not qml_path.is_file():
        raise RuntimeError(f"required QML file is missing: {qml_name}")
    qml = qml_path.read_text(encoding="utf-8")
    if qml.count(module_line) != 1:
        raise RuntimeError(f"{qml_name} moduleName does not match the manifest ID exactly once")

symlinks = []
for path in root.rglob("*"):
    relative = path.relative_to(root)
    if relative.parts and relative.parts[0] == ".git":
        continue
    if path.is_symlink():
        symlinks.append(str(relative))
if symlinks:
    raise RuntimeError(f"repository payload contains symlinks: {symlinks}")

lines = runtime_list.read_text(encoding="utf-8").splitlines()
runtime_paths = []
for line in lines:
    value = line.strip()
    if not value:
        continue
    candidate = PurePosixPath(value)
    if candidate.is_absolute() or ".." in candidate.parts:
        raise RuntimeError(f"unsafe runtime path: {value}")
    if value in runtime_paths:
        raise RuntimeError(f"duplicate runtime path: {value}")
    path = root / value
    if not path.is_file() or path.is_symlink():
        raise RuntimeError(f"runtime file is missing or unsafe: {value}")
    runtime_paths.append(value)

for required_path in ("manifest.json", entry, "Model.js", "LICENSE", "README.md"):
    if required_path not in runtime_paths:
        raise RuntimeError(f"required runtime file is not allowlisted: {required_path}")
PY

omarchy plugin validate "$repo"
qmllint -I "$omarchy_path/shell" "$repo/BarWidget.qml" "$repo/Panel.qml"
node "$repo/tests/model-test.js"
grep -Fq 'interval: 3000' "$repo/BarWidget.qml"
grep -Fq -- '--query-gpu=temperature.gpu,fan.speed' "$repo/BarWidget.qml"
grep -Fq 'readingLabelWidth' "$repo/Panel.qml"
grep -Fq 'fanReadingText(fan, true)' "$repo/Panel.qml"
grep -Fq 'omarchy restart shell' "$repo/scripts/dev-deploy"
grep -Fq '25–35% resonance band' "$repo/docs/HUGIN_DISPLAY_POLICY.md"
grep -Fq 'Never write RTX 4090 fan controls.' "$repo/docs/HUGIN_DISPLAY_POLICY.md"
bash -n "$repo/scripts/validate" "$repo/scripts/dev-deploy" "$repo/scripts/dev-remove"

if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$repo" diff --check
fi

echo "Fan Monitor validation: PASS"
